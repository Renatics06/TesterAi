--- !u!114 &714579304
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 714579303}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7755429018557ea40bd88b66a94d154a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhysicalReport
  pagePrefab: {fileID: 8813533827452976052, guid: af8b67370ba23354ba0256307af76cb4, type: 3}
  pagesAnchor: {fileID: 1988791368}
  pageScaleMultiplier: 1
  categories: []
  customPage1Corporate: {fileID: 0}
  customPage2Notes: {fileID: 0}
  corporateHeader: "\u0415\u0412\u0420\u041E\u041F\u0415\u0419\u0421\u041A\u0418\u0419
    \u0426\u0415\u041D\u0422\u0420 \u0410\u041D\u041E\u041C\u0410\u041B\u042C\u041D\u042B\u0425
    \u0418\u0421\u0421\u041B\u0415\u0414\u041E\u0412\u0410\u041D\u0418\u0419 (\u0415\u0426\u0410\u0418)\n\u0414\u0415\u041F\u0410\u0420\u0422\u0410\u041C\u0415\u041D\u0422
    \u041A\u041E\u041D\u0422\u0420\u041E\u041B\u042F \u0423\u041B\u0418\u041A \u0418
    \u0421\u0420\u0415\u0414\u042B\n\n\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415:
    \u0412\u0441\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0435
    \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438 \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0442
    \u0441\u0442\u0440\u043E\u0433\u043E\u043C\u0443 \u0443\u0447\u0435\u0442\u0443.
    \u041F\u0440\u044F\u043C\u043E\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0441 \u043D\u0435\u0437\u0430\u0449\u0438\u0449\u0435\u043D\u043D\u044B\u043C\u0438
    \u043E\u0431\u0440\u0430\u0437\u0446\u0430\u043C\u0438 \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D.
    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043C\u0435\u0442\u043E\u0434
    \u043F\u043E\u043B\u0435\u0432\u043E\u0439 \u0437\u0430\u0440\u0438\u0441\u043E\u0432\u043A\u0438."
  investigatorNotes: "\u0417\u0410\u041F\u0418\u0421\u041A\u0418 \u041F\u0420\u0415\u0414\u0428\u0415\u0421\u0422\u0412\u0415\u041D\u041D\u0418\u041A\u0410
    (\u0421\u041B\u0415\u0414\u041E\u0412\u0410\u0422\u0415\u041B\u042C \u0420. \u0412\u0410\u041D
    \u0422\u0415\u041B\u042C):\n'14 \u043D\u043E\u044F\u0431\u0440\u044F. \u041E\u043D\u0438
    \u0437\u0434\u0435\u0441\u044C \u0432\u0435\u0437\u0434\u0435. \u042D\u0442\u043E\u0442
    \u0447\u0435\u043C\u043E\u0434\u0430\u043D... \u043D\u0435\u043B\u044C\u0437\u044F
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430.
    \u0422\u043E\u0442, \u0447\u0442\u043E \u0432 \u0448\u043A\u0430\u0444\u0443,
    \u0441\u0442\u0443\u0447\u0438\u0442 \u043F\u043E \u043D\u043E\u0447\u0430\u043C.
    \u0415\u0441\u043B\u0438 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u0441\u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u0440\u043E \u043F\u044F\u0442\u043D\u0430
    \u043D\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u0445
    \u2014 \u043F\u0438\u0448\u0438\u0442\u0435, \u0447\u0442\u043E \u044D\u0442\u043E
    \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C. \u0414\u0435\u043B\u0430\u0439\u0442\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0435\u0442\u0447\u0438, \u043D\u0435
    \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043D\u0438\u0445
    \u0434\u043E\u043B\u0433\u043E...'"
--- !u!64 &714579305
