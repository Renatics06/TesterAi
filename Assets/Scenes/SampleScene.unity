  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u043B\u0430\u0432\u0438\u0448\u0438 1 \u0438 2 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438 \u043F\u043E\u0434
    \u0442\u0435\u0441\u0442\u043E\u0432\u044B\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0432 CharacterStateManager.cs.   \n[Space] (\u043F\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435
    \u043F\u0440\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u0439\u0441\u044F \u0443\u043B\u0438\u043A\u0438)
    \u2014 \u0434\u0435\u043B\u0430\u0435\u0442 \u0437\u0430\u0440\u0438\u0441\u043E\u0432\u043A\u0443
    \u043E\u0442 \u0440\u0443\u043A\u0438 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 \u0432 \u043A\u043E\u043D\u0435\u0446
    \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430.\n[Q] / [W] / [E] / [R] (\u043F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0440\u0438\u0441\u043E\u0432\u043A\u0438) \u2014 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u044E\u0442
    4 \u043F\u0443\u043D\u043A\u0442\u0430 \u0447\u0435\u043A-\u043B\u0438\u0441\u0442\u0430
    \u043F\u0440\u044F\u043C\u043E \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435.\n[A]
    / [D] (\u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u2190 /
    \u2192) \u2014 \u043B\u0438\u0441\u0442\u0430\u044E\u0442 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
    \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430.[Backspace] (\u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
    \u0443\u043B\u0438\u043A\u0438 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435)
    \u2014 \u0432\u044B\u0440\u044B\u0432\u0430\u0435\u0442 \u0438 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
    \u0442\u0435\u043A\u0443\u0449\u0443\u044E \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443."
  m_isRightToLeft: 0
